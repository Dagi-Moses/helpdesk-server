# Server
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://helpdesk_user:helpdesk_pass@localhost:5432/helpdesk_db?schema=public"

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000


ALLOWED_EMAIL_DOMAINS=yourdomain.com
FRONTEND_URL=https://your-frontend-domain.com

SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="IT Helpdesk <no-reply@yourdomain.com>"

API_URL=http://localhost:4000